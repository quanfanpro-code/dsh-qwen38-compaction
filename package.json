{
  "name": "dsh-qwen38-compaction",
  "version": "0.1.3",
  "description": "DSH 与 Qwen3.8 上下文压缩适配：保留原模型接入及普通聊天行为",
  "type": "module",
  "license": "MIT",
  "repository": "github:quanfanpro-code/dsh-qwen38-compaction",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": "./dist/adapter.mjs",
    "./presets": "./src/模式入口.mjs",
    "./compaction": "./dist/compaction.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/构建.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent-presets": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.2-rc.1",
    "undici": "7.29.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-compaction-basic": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent-loop": "0.1.2-rc.1",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.1.2-rc.1",
    "js-yaml": "4.2.0"
  }
}
